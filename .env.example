# =============================================================================
# 3DGRUT API — Machine-specific configuration
#
# Usage:
#   cp .env.example .env
#   vim .env              # set paths for THIS machine
#   docker compose up --build -d
#
# .env is gitignored — never commit it.
# =============================================================================

# ── CUDA version ────────────────────────────────────────────────────────────
# 11.8.0 = most compatible (default)
# 12.8.1 = for Blackwell GPUs (RTX 5090, RTX Pro 6000)
CUDA_VERSION=11.8.0

# ── GPU assignment ──────────────────────────────────────────────────────────
# Run `nvidia-smi` to see available GPU IDs.
THREEDGRUT_GPU_ID=0

# Max concurrent GPU jobs (1 = safe default for single GPU)
THREEDGRUT_MAX_GPU_JOBS=1

# ── Port ────────────────────────────────────────────────────────────────────
THREEDGRUT_PORT=8191

# ── Storage paths ───────────────────────────────────────────────────────────
# Persistent directory for job data (uploads, outputs, artifacts).
# This directory can grow large — use a disk with enough space.
THREEDGRUT_DATA_PATH=./data

# HuggingFace model cache (shared across AI services).
# Examples:
#   /pegaai/model_team/huggingface_cache   (prod server)
#   ./hf_cache                              (dev/local)
HF_CACHE_HOST_PATH=./hf_cache
